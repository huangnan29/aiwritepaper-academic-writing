{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangnan29/aiwritepaper-academic-writing/references/schemas/profile-selection.schema.json",
  "title": "AIWritePaper Profile Selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "selected_profile", "selection_source", "model_label",
    "agent_adapter", "compiled_variant", "profile_rules", "reason_codes",
    "capability_report", "capability_report_sha256", "matched_prior_adjudications", "selector"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selected_profile": {"enum": ["FULL_AUTONOMY", "GUIDED", "WEAK_MODEL"]},
    "selection_source": {
      "enum": ["USER_OVERRIDE", "PRIOR_ADJUDICATION", "CAPABILITY_GAP", "DEFAULT_STRONG_PRESERVING"]
    },
    "model_label": {"type": "string", "minLength": 1},
    "agent_adapter": {"type": "string", "minLength": 1},
    "compiled_variant": {"enum": ["full", "compact"]},
    "profile_rules": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "capability_report": {"type": "string", "minLength": 1},
    "capability_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matched_prior_adjudications": {"type": "array", "items": {"type": "object"}},
    "selector": {
      "type": "object",
      "required": ["name", "version", "sha256", "generated_at"],
      "properties": {
        "name": {"const": "select_execution_profile.py"},
        "version": {"const": "1.5.0"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
