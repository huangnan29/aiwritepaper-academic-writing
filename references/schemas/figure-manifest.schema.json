{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangnan29/aiwritepaper-agentic-skill/figure-manifest.schema.json",
  "title": "AIWritePaper Figure Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "figures"],
  "properties": {
    "schema_version": {"const": "1.4"},
    "figures": {
      "type": "array",
      "items": {"$ref": "#/$defs/figure"}
    }
  },
  "$defs": {
    "nullablePath": {"type": ["string", "null"]},
    "figure": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "figure_id", "display_number", "title", "figure_type", "exactness_class", "imagegen_eligible", "route_exemption", "claim_bearing", "generation_route",
        "data_status", "prompt_file", "generated_file", "fallback_file", "source_data",
        "transformation", "caption_claim", "supported_manuscript_claims", "limitations",
        "canvas_contains_figure_number_or_caption", "final_embed_file", "generation_receipt",
        "svg_layout_mode", "svg_layout", "vlm_verification"
      ],
      "properties": {
        "figure_id": {"type": "string", "minLength": 1},
        "display_number": {"type": "string", "pattern": "^[0-9]+(?:-[0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "figure_type": {"enum": ["ARCHITECTURE", "PROCESS", "ER_UML", "STATISTICAL", "NETWORK_DATA", "DOMAIN", "EVIDENCE_IMAGE"]},
        "exactness_class": {"enum": ["SEMANTIC_STRUCTURE", "DOMAIN_EXACT", "DATA_GRAPH", "EVIDENCE_IMAGE"]},
        "imagegen_eligible": {"type": "boolean"},
        "route_exemption": {"type": ["string", "null"], "enum": ["USER_REQUESTED_VECTOR", "PUBLICATION_RESTRICTION", "IMAGE_TOOL_UNAVAILABLE", "DOMAIN_EXACTNESS", "EVIDENCE_REQUIRED", null]},
        "claim_bearing": {"type": "boolean"},
        "generation_route": {"enum": ["IMAGE_GENERATION", "DATA_CODE", "DOMAIN_TOOL", "EVIDENCE_FILE", "SVG_FALLBACK"]},
        "data_status": {"enum": ["OBSERVED", "VERIFIED_EXTERNAL", "SIMULATED_RESEARCH", "NOT_APPLICABLE"]},
        "prompt_file": {"$ref": "#/$defs/nullablePath"},
        "generated_file": {"$ref": "#/$defs/nullablePath"},
        "fallback_file": {"$ref": "#/$defs/nullablePath"},
        "source_data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "sha256", "origin"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "origin": {"enum": ["USER_PROVIDED", "OFFICIAL_DOWNLOAD", "AUTHOR_OBSERVED", "FORMAL_SIMULATION", "MODEL_SYNTHETIC", "MANUSCRIPT_CONTEXT"]},
              "acquisition_receipt": {"type": ["object", "null"]}
            }
          }
        },
        "transformation": {"type": "object"},
        "caption_claim": {"type": ["string", "null"]},
        "supported_manuscript_claims": {"type": "array"},
        "limitations": {"type": "array"},
        "canvas_contains_figure_number_or_caption": {"const": false},
        "final_embed_file": {"type": "string", "pattern": "\\.(png|jpe?g|webp)$"},
        "generation_receipt": {"type": ["object", "null"]},
        "svg_layout_mode": {"type": ["string", "null"], "enum": ["NATIVE", "COMPILED", null]},
        "svg_layout": {"type": ["object", "null"]},
        "vlm_verification": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"exactness_class": {"const": "DATA_GRAPH"}}},
          "then": {"properties": {"generation_route": {"const": "DATA_CODE"}, "imagegen_eligible": {"const": false}}}
        },
        {
          "if": {"properties": {"exactness_class": {"const": "EVIDENCE_IMAGE"}}},
          "then": {"properties": {"generation_route": {"const": "EVIDENCE_FILE"}, "imagegen_eligible": {"const": false}}}
        },
        {
          "if": {"properties": {"exactness_class": {"const": "DOMAIN_EXACT"}}},
          "then": {"properties": {"imagegen_eligible": {"const": false}, "generation_route": {"not": {"const": "IMAGE_GENERATION"}}}}
        },
        {
          "if": {"properties": {"generation_route": {"const": "IMAGE_GENERATION"}}},
          "then": {
            "properties": {
              "prompt_file": {"type": "string", "minLength": 1},
              "generated_file": {"type": "string", "minLength": 1},
              "generation_receipt": {
                "type": "object",
                "required": ["evidence_level", "tool", "provider", "model", "invoked_at", "call_id", "receipt_file", "receipt_sha256", "prompt_sha256", "generated_sha256"]
              }
            }
          }
        },
        {
          "if": {"properties": {"generation_route": {"const": "DATA_CODE"}}},
          "then": {
            "properties": {
              "source_data": {"minItems": 1},
              "transformation": {
                "type": "object",
                "required": ["script", "sha256", "execution_receipt"]
              }
            }
          }
        },
        {
          "if": {"properties": {"generation_route": {"const": "SVG_FALLBACK"}}},
          "then": {
            "properties": {
              "svg_layout_mode": {"enum": ["NATIVE", "COMPILED"]}
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation_route": {"const": "SVG_FALLBACK"},
              "svg_layout_mode": {"const": "COMPILED"}
            }
          },
          "then": {
            "properties": {
              "svg_layout": {
                "type": "object",
                "required": ["spec_file", "spec_sha256", "report_file", "report_sha256", "renderer", "renderer_sha256"]
              }
            }
          }
        }
      ]
    }
  }
}
