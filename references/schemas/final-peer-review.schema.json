{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version", "direction_id", "status", "reviewer_mode", "issues",
    "alignment", "reviewed_artifacts"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "direction_id": {"type": "string"},
    "status": {"enum": ["PASS", "FAIL", "PARTIAL", "REVIEWED"]},
    "reviewer_mode": {"enum": ["ISOLATED", "SELF"]},
    "issues": {
      "type": "object",
      "required": ["critical_open", "important_open"],
      "properties": {
        "critical_open": {"type": "integer", "minimum": 0},
        "important_open": {"type": "integer", "minimum": 0}
      }
    },
    "alignment": {
      "type": "object",
      "required": [
        "title_supported", "research_question_answered", "method_result_consistent",
        "abstract_conclusion_consistent"
      ],
      "properties": {
        "title_supported": {"type": "boolean"},
        "research_question_answered": {"type": "boolean"},
        "method_result_consistent": {"type": "boolean"},
        "abstract_conclusion_consistent": {"type": "boolean"}
      }
    },
    "scores": {"type": "object"},
    "total": {"type": "number"},
    "reviewed_artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
    }
  },
  "dependentRequired": {"scores": ["total"], "total": ["scores"]},
  "allOf": [{"if": {"properties": {"schema_version": {"const": "1.0"}}}, "then": {"required": ["scores", "total"], "properties": {"reviewer_mode": {"const": "ISOLATED"}}}, "else": {"properties": {"issues": {"required": ["items"]}}}}]
}
