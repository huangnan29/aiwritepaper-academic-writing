{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangnan29/aiwritepaper-academic-writing/capability-report.schema.json",
  "title": "AIWritePaper Capability Report 2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_adapter", "recorded_at", "image_generation", "visual_inspection", "docx_export", "pdf_export"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "agent_adapter": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "observed_at": {"type": ["string", "null"]},
    "image_generation": {"$ref": "#/$defs/capability"},
    "visual_inspection": {"$ref": "#/$defs/capability"},
    "docx_export": {"$ref": "#/$defs/capability"},
    "pdf_export": {"$ref": "#/$defs/capability"}
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "tool", "caller", "evidence"],
      "properties": {
        "available": {"type": ["boolean", "null"]},
        "tool": {"type": ["string", "null"]},
        "caller": {"enum": ["CURRENT_AGENT", "PARENT_AGENT", "CLIENT", "MCP_OR_PLUGIN", null]},
        "evidence": {"type": ["string", "null"]}
      }
    }
  }
}
